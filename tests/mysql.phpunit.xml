<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" colors="true" bootstrap="bootstrap.php">
  <testsuites>
    <testsuite name="propel2">
      <directory>Propel/Tests/Common</directory>
      <directory>Propel/Tests/Helpers</directory>
      <directory>Propel/Tests/Runtime</directory>
      <directory>Propel/Tests/Bookstore</directory>
      <directory>Propel/Tests/</directory>
    </testsuite>
  </testsuites>
  <groups>
    <include>
      <group>database</group>
    </include>
  </groups>
  <php>
    <env name="DB" value="mysql"/>
    <env name="DB_USER" value="root"/>
  </php>
  <source>
    <include>
      <directory>../src/Propel/</directory>
    </include>
  </source>
</phpunit>
